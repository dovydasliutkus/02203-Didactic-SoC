########################################
# Sim makefile - Windows
# Questa targets delegate to Makefile (which uses SHELL=bash).
# Windows-only targets: env (CMD mkdir), gen_flist/gen_includes (PowerShell).
########################################

SHELL = cmd

BUILD_DIR      ?= $(CURDIR)\..\build
BUILD_DIR_FWD   = $(subst \,/,$(BUILD_DIR))
TESTCASE       ?= blink
SANITY_CHECK   ?= 0
FAST_UART      ?= 1
SIM_UART_MODEL ?= 1
BYPASS_UART    ?= 0
GUI            ?= -c

# Single delegation point: all Questa targets call $(QUESTA) <target>
QUESTA = $(MAKE) -f Makefile \
	BUILD_DIR=$(BUILD_DIR_FWD) \
	TESTCASE=$(TESTCASE) \
	SANITY_CHECK=$(SANITY_CHECK) \
	FAST_UART=$(FAST_UART) \
	SIM_UART_MODEL=$(SIM_UART_MODEL) \
	BYPASS_UART=$(BYPASS_UART) \
	GUI=$(GUI)

# ============================================================
# Build directory creation
# ============================================================
env:
	if not exist "$(BUILD_DIR)\logs\compile" mkdir "$(BUILD_DIR)\logs\compile"
	if not exist "$(BUILD_DIR)\logs\opt"     mkdir "$(BUILD_DIR)\logs\opt"
	if not exist "$(BUILD_DIR)\logs\sim"     mkdir "$(BUILD_DIR)\logs\sim"
	if not exist "stdout"      mkdir stdout
	if not exist "stdout\uart" type nul > stdout\uart

# ============================================================
# Questa targets — delegate to Makefile
# ============================================================
compile: env
	$(QUESTA) compile_didactic

elaborate:
	$(QUESTA) elaborate

elaborate_fast:
	$(QUESTA) elaborate_fast

run_sim: env
	$(QUESTA) run_sim

compile_ss: env
	$(QUESTA) compile_ss

elaborate_ss:
	$(QUESTA) elaborate_ss

run_ss:
	$(QUESTA) run_ss

sim_ss:
	$(QUESTA) sim_ss
