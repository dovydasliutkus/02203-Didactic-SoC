########################################
# FPGA makefile - Windows
# Vivado runs natively; SW compilation delegated to WSL.
# flist.f / flist_bscane.f / includes.txt are committed (Linux-generated,
# relative paths) and work with Windows Vivado as-is.
########################################

SHELL  = cmd
WSL    = wsl
VIVADO ?= vivado
TEST   ?= blink

export BUILD_DIR ?= $(CURDIR)/../build
export PROJECT   ?= nexys_a7

check_env:
	if not exist "$(BUILD_DIR)" mkdir "$(BUILD_DIR)"

all_xilinx: check_env
	$(VIVADO) -mode batch -notrace -source scripts\run_xilinx.tcl

all_xilinx_gui: check_env
	start $(VIVADO) -mode gui -source scripts\run_xilinx.tcl

# SW compiled inside WSL
build_test: check_env
	$(WSL) make -C $(shell $(WSL) wslpath '$(CURDIR)')/sw \
		BUILD_DIR=$(shell $(WSL) wslpath '$(BUILD_DIR)')/fpga \
		TESTCASE=$(TEST) \
		test

load_elf: check_env
	gdb-multiarch $(BUILD_DIR)\fpga\sw\$(TEST).elf -x utils\connect-and-load.gdb
